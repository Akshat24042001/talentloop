# ---- Required ----
# Your https tunnel URL (cloudflared / ngrok). Vapi calls this server, so it must be public.
PUBLIC_URL=https://your-tunnel.trycloudflare.com
# Vapi dashboard -> API Keys -> Public key (safe for the browser)
VAPI_PUBLIC_KEY=
# LLM (any OpenAI-compatible endpoint)
LLM_API_KEY=sk-...
LLM_BASE_URL=
FAST_MODEL=gpt-4.1-mini
SMART_MODEL=gpt-4.1

# ---- Recommended ----
# Protects HR pages and the report. Leave empty only on your own laptop.
# Use a long random string (python -c "import secrets;print(secrets.token_urlsafe(24))"). The server warns if weak.
ADMIN_KEY=

# ---- Tuning (defaults are sensible) ----
# 1 = run without any API key (fake AI), to click through the flow
LLM_MOCK=0
# smart = LiveKit end-of-turn model via Vapi ; patient = fixed silence window (use if candidates get cut off)
ENDPOINTING_MODE=smart
PATIENT_TIMEOUT_SEC=2.2
STT_MODEL=nova-3
STT_LANGUAGE=en-IN
STT_KEYTERMS=1
# Any voice from Vapi's voice library. Indian English voice helps comprehension.
VOICE_PROVIDER=azure
VOICE_ID=en-IN-NeerjaNeural
# Run scoring twice and flag disagreements (costs 2x scoring)
SCORING_PASSES=1
TURN_TIMEOUT_SEC=7
MAX_RECONNECTS=3
# Vapi hangs up after this many seconds of total silence (Vapi default is 30, far too short for interviews)
SILENCE_TIMEOUT_SEC=120
# After this many seconds of silence the interviewer gently checks in (max 2 times)
IDLE_TIMEOUT_SEC=25
# Only download call recordings from these hosts (SSRF protection)
RECORDING_HOSTS=vapi.ai
# Max stored recording size per interview
MEDIA_CAP_MB=700
