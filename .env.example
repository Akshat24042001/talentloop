# ---- Required ----
# Your https tunnel URL (cloudflared / ngrok). Vapi calls this server, so it must be public.
PUBLIC_URL=https://your-tunnel.trycloudflare.com
# Vapi dashboard -> API Keys -> Public key (safe for the browser)
VAPI_PUBLIC_KEY=
# LLM. An OpenRouter key (sk-or-...) needs nothing else: free models are picked and checked at startup.
# An OpenAI key uses gpt-4.1-mini (live) and gpt-4.1 (plan, scoring).
LLM_API_KEY=
# Optional overrides. Comma-separated = fallback chain. OpenRouter paid example:
#   FAST_MODEL=openai/gpt-4.1-mini   SMART_MODEL=anthropic/claude-sonnet-5
LLM_BASE_URL=
FAST_MODEL=
SMART_MODEL=

# ---- Accounts and data ----
# Your email(s): signing up with one gives you the Platform admin console (all companies, users, counts).
PLATFORM_ADMIN_EMAILS=
# Postgres (Supabase Session pooler URI). Empty = SQLite file in DATA_DIR (fine on a laptop, wiped on Render free).
DATABASE_URL=
# Files (resumes, recordings) in any S3-compatible bucket. Supabase: endpoint https://<ref>.supabase.co/storage/v1/s3
# and S3_REGION = your project region. Empty = local disk in DATA_DIR.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long people stay signed in (days)
SESSION_DAYS=14
# Optional API key for scripts (send X-Admin-Key, plus X-Org: <company slug> for company endpoints).
# People sign in with email and password instead. Use a long random string if you set it.
ADMIN_KEY=

# ---- Tuning (defaults are sensible) ----
# 1 = run without any API key (fake AI), to click through the flow
LLM_MOCK=0
# smart = LiveKit end-of-turn model via Vapi ; patient = fixed silence window (use if candidates get cut off)
ENDPOINTING_MODE=smart
PATIENT_TIMEOUT_SEC=2.2
STT_MODEL=nova-3
STT_LANGUAGE=en-IN
STT_KEYTERMS=1
# Any voice from Vapi's voice library. Indian English voice helps comprehension.
VOICE_PROVIDER=vapi
VOICE_ID=Naina
# Empty = 2 scoring passes with free models (two different models, disagreements flagged), 1 otherwise
SCORING_PASSES=
TURN_TIMEOUT_SEC=8
MAX_RECONNECTS=3
# Silence handling (Vapi hooks): gentle check-in after IDLE_TIMEOUT_SEC, hang up after SILENCE_TIMEOUT_SEC
IDLE_TIMEOUT_SEC=25
SILENCE_TIMEOUT_SEC=120
# Seconds a candidate has to rejoin after a dropped call (HR can change it per interview)
RECONNECT_WINDOW_SEC=30
# Max stored recording size per interview
MEDIA_CAP_MB=900
# 1 = also ask Vapi to record the call video in its cloud (a backup copy with both voices)
VAPI_VIDEO_RECORDING=1
# Optional: Vapi PRIVATE key. Lets the server fetch Vapi's cloud video after the call. Never put it in the browser.
VAPI_PRIVATE_KEY=
# Delete interviews older than this many days (0 = keep forever). Supports data-protection retention rules.
RETENTION_DAYS=0
# Timezone for dates in PDF reports
REPORT_TZ=Asia/Kolkata

# ---- Storage details (bucket settings are under "Accounts and data" above) ----
# Backblaze B2 works too: S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com (region is read from it)
S3_PREFIX=talentloop
# Set to 1 only if DATA_DIR is on a persistent disk (hides the "temporary storage" warning)
PERSISTENT_DISK=
