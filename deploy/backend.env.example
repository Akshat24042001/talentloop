# =====================================================================================================
# TalentLoop BACKEND environment (FastAPI on Render, Railway, a VPS, or your laptop)
# Copy the values into Render > your service > Environment. On a laptop, save this file as ".env" in the
# repo root. Lines starting with # are comments. Never commit a filled-in copy.
# =====================================================================================================

# ---------------------------------------------------------------- 1. REQUIRED -----------------------

# Database: Supabase > Connect > "Session pooler" URI, with your database password filled in.
# Empty = a SQLite file in DATA_DIR (fine on a laptop; on Render free it is WIPED on every restart).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Your email(s), comma-separated. Signing up with one of these gives the "Platform admin" console.
PLATFORM_ADMIN_EMAILS=you@yourcompany.com

# File storage for resumes and interview recordings: Supabase > Storage > Settings > S3 Connection.
# Create a PRIVATE bucket first (Storage > New bucket). Empty = local disk (wiped on Render free).
S3_BUCKET=talentloop
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=<supabase-s3-access-key-id>
S3_SECRET_ACCESS_KEY=<supabase-s3-secret-access-key>

# AI: an OpenRouter key (sk-or-...) picks free models automatically; an OpenAI key (sk-...) uses gpt-4.1-mini / gpt-4.1.
LLM_API_KEY=sk-or-<your-openrouter-key>
LLM_MOCK=0

# Voice interviews: Vapi dashboard > API Keys > PUBLIC key (safe in the browser).
VAPI_PUBLIC_KEY=<vapi-public-key>

# ---------------------------------------------------------------- 2. DEPENDS ON YOUR SETUP ----------

# The public address of the BACKEND. Vapi calls it during interviews. Leave EMPTY on Render and Railway
# (detected automatically). Set it on a VPS or laptop tunnel, e.g. https://abc.trycloudflare.com
PUBLIC_URL=

# The address people open in their browser, used in candidate interview links.
# Leave EMPTY when the backend also serves the website (one Render service).
# Set it when the frontend is on Vercel or a custom domain, e.g. https://app.talentloop.in
APP_URL=

# Vapi PRIVATE key: lets the server download Vapi's cloud video backup after a call. Never put it in the frontend.
VAPI_PRIVATE_KEY=

# Paid models for real candidates (free models may log prompts, which include resumes). Comma = fallback chain.
# OpenRouter examples: FAST_MODEL=openai/gpt-4.1-mini   SMART_MODEL=openai/gpt-4.1
FAST_MODEL=
SMART_MODEL=
# Only for a non-OpenRouter, OpenAI-compatible provider. Empty = automatic.
LLM_BASE_URL=

# Optional API key for scripts (header X-Admin-Key, plus X-Org: <company slug> for company endpoints).
# People sign in with email and password, so leave it empty unless you automate something. 20+ random characters.
ADMIN_KEY=

# ---------------------------------------------------------------- 3. OPTIONAL (defaults are fine) ---

# Sign-in
SESSION_DAYS=14
# auto = Secure cookie on https (correct behind Render, Vercel, Cloudflare). 1 = always, 0 = never.
COOKIE_SECURE=auto

# Storage details
S3_PREFIX=talentloop
# 1 = force path-style S3 URLs (automatic for Supabase; needed for MinIO)
S3_PATH_STYLE=
# Where local files and the SQLite database live. The Docker image already sets /data; on a laptop leave it
# commented out (default: ./data).
# DATA_DIR=/data
# 1 only if DATA_DIR is on a persistent disk (hides the "temporary storage" warning)
PERSISTENT_DISK=

# Interview voice and listening
VOICE_PROVIDER=vapi
VOICE_ID=Naina
VOICE_VERSION=2
# 0.7 to 1.2; empty = the voice's normal speed
VOICE_SPEED=
STT_MODEL=nova-3
STT_LANGUAGE=en-IN
STT_KEYTERMS=1
# smart = model-based end of turn ; patient = fixed silence window (use if candidates get cut off)
ENDPOINTING_MODE=smart
SMART_ENDPOINTING_PROVIDER=livekit
PATIENT_TIMEOUT_SEC=2.2

# Interview flow
TURN_TIMEOUT_SEC=8
IDLE_TIMEOUT_SEC=25
SILENCE_TIMEOUT_SEC=120
RECONNECT_WINDOW_SEC=30
MAX_RECONNECTS=3
FINISH_DELAY_SEC=25
# Empty = 2 scoring passes with free models, 1 otherwise
SCORING_PASSES=
# 0 only if your model provider rejects JSON mode
LLM_JSON_MODE=1

# Recordings and data retention
MEDIA_CAP_MB=900
VAPI_VIDEO_RECORDING=1
# Delete interviews older than this many days (0 = keep forever)
RETENTION_DAYS=0
SWEEP_EVERY_SEC=30

# Misc
REPORT_TZ=Asia/Kolkata
LOG_LEVEL=INFO
# Serve the website from another folder (default: frontend/dist)
WEB_DIR=
